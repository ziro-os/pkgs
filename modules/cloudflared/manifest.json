{
  "name": "cloudflared",
  "version": "2026.10.2",
  "description": "Cloudflare Tunnel: publish services without a public IP, with optional Zero Trust Access (ziroctl cf)",
  "settings": [
    {
      "name": "auto_update",
      "description": "upgrade cloudflared daily to the version this catalog pins",
      "default": "true",
      "pattern": "^(true|false)$"
    }
  ],
  "artifacts": [
    {
      "url": "https://github.com/cloudflare/cloudflared/releases/download/2026.10.2/cloudflared-linux-amd64",
      "sha256": "35fbdd2beb378436c7da377d7358cea8e33f9c94a6705d1d8036bf9b0d6d8005",
      "path": "/var/lib/ziro/plugins/cloudflared/cloudflared",
      "mode": "0755",
      "arch": "x86_64"
    },
    {
      "url": "https://github.com/cloudflare/cloudflared/releases/download/2026.10.2/cloudflared-linux-arm64",
      "sha256": "b7e55b4d9702c2ab5f8348f780bb1db044527fc555367714c78e0595750a4665",
      "path": "/var/lib/ziro/plugins/cloudflared/cloudflared",
      "mode": "0755",
      "arch": "aarch64"
    }
  ],
  "dirs": [
    {
      "path": "/etc/ziro/cloudflared",
      "mode": "0700"
    }
  ],
  "cron": [
    "23 4 * * * /usr/bin/ziroctl cf update --cron"
  ],
  "stop": [
    {
      "exec": "/usr/bin/ziroctl",
      "args": [
        "cf",
        "down"
      ]
    }
  ],
  "health": {
    "exec": "/var/lib/ziro/plugins/cloudflared/cloudflared",
    "args": [
      "--version"
    ],
    "expect": "cloudflared version"
  }
}
