{
  "name": "cloudflared",
  "version": "2026.11.0",
  "description": "Cloudflare Tunnel: publish services without a public IP, with optional Zero Trust Access (ziroctl cf)",
  "settings": [
    {
      "name": "auto_update",
      "description": "upgrade cloudflared daily to the version this catalog pins",
      "default": "true",
      "pattern": "^(true|false)$"
    }
  ],
  "artifacts": [
    {
      "url": "https://github.com/cloudflare/cloudflared/releases/download/2026.11.0/cloudflared-linux-amd64",
      "sha256": "51f7c68b57ed7269164075d7e789efce5b59355982f06392deeb037d982a51fd",
      "path": "/var/lib/ziro/plugins/cloudflared/cloudflared",
      "mode": "0755",
      "arch": "x86_64"
    },
    {
      "url": "https://github.com/cloudflare/cloudflared/releases/download/2026.11.0/cloudflared-linux-arm64",
      "sha256": "abe54a006acf9faf2d19ee9d953cb0d0804e92f59c5382a162e57b84d086f56f",
      "path": "/var/lib/ziro/plugins/cloudflared/cloudflared",
      "mode": "0755",
      "arch": "aarch64"
    }
  ],
  "dirs": [
    {
      "path": "/etc/ziro/cloudflared",
      "mode": "0700"
    }
  ],
  "cron": [
    "23 4 * * * /usr/bin/ziroctl cf update --cron"
  ],
  "stop": [
    {
      "exec": "/usr/bin/ziroctl",
      "args": [
        "cf",
        "down"
      ]
    }
  ],
  "health": {
    "exec": "/var/lib/ziro/plugins/cloudflared/cloudflared",
    "args": [
      "--version"
    ],
    "expect": "cloudflared version"
  }
}
