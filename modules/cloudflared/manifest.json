{
  "name": "cloudflared",
  "version": "2026.10.1",
  "description": "Cloudflare Tunnel: publish services without a public IP, with optional Zero Trust Access (ziroctl cf)",
  "settings": [
    {
      "name": "auto_update",
      "description": "upgrade cloudflared daily to the version this catalog pins",
      "default": "true",
      "pattern": "^(true|false)$"
    }
  ],
  "artifacts": [
    {
      "url": "https://github.com/cloudflare/cloudflared/releases/download/2026.10.1/cloudflared-linux-amd64",
      "sha256": "3bfc539f45d2620c71debb7a86be0efa737ed5ccbad9eb85c787116900e5c586",
      "path": "/var/lib/ziro/plugins/cloudflared/cloudflared",
      "mode": "0755",
      "arch": "x86_64"
    },
    {
      "url": "https://github.com/cloudflare/cloudflared/releases/download/2026.10.1/cloudflared-linux-arm64",
      "sha256": "2c65dfabf616c40efc7545d107d7a57ad5e21377e2964b7e88af19a238074a46",
      "path": "/var/lib/ziro/plugins/cloudflared/cloudflared",
      "mode": "0755",
      "arch": "aarch64"
    }
  ],
  "dirs": [
    {
      "path": "/etc/ziro/cloudflared",
      "mode": "0700"
    }
  ],
  "cron": [
    "23 4 * * * /usr/bin/ziroctl cf update --cron"
  ],
  "stop": [
    {
      "exec": "/usr/bin/ziroctl",
      "args": [
        "cf",
        "down"
      ]
    }
  ],
  "health": {
    "exec": "/var/lib/ziro/plugins/cloudflared/cloudflared",
    "args": [
      "--version"
    ],
    "expect": "cloudflared version"
  }
}
