{
  "name": "cloudflared",
  "version": "2026.10.5",
  "description": "Cloudflare Tunnel: publish services without a public IP, with optional Zero Trust Access (ziroctl cf)",
  "settings": [
    {
      "name": "auto_update",
      "description": "upgrade cloudflared daily to the version this catalog pins",
      "default": "true",
      "pattern": "^(true|false)$"
    }
  ],
  "artifacts": [
    {
      "url": "https://github.com/cloudflare/cloudflared/releases/download/2026.10.5/cloudflared-linux-amd64",
      "sha256": "e1bc0cf084fd9e590554fe769a86b1db46701c3f847a43d902f7b974a4e16298",
      "path": "/var/lib/ziro/plugins/cloudflared/cloudflared",
      "mode": "0755",
      "arch": "x86_64"
    },
    {
      "url": "https://github.com/cloudflare/cloudflared/releases/download/2026.10.5/cloudflared-linux-arm64",
      "sha256": "72e0d05a67e09da87cf495e409a28c3cc5994dd23fc66a982eebea6a55923b7d",
      "path": "/var/lib/ziro/plugins/cloudflared/cloudflared",
      "mode": "0755",
      "arch": "aarch64"
    }
  ],
  "dirs": [
    {
      "path": "/etc/ziro/cloudflared",
      "mode": "0700"
    }
  ],
  "cron": [
    "23 4 * * * /usr/bin/ziroctl cf update --cron"
  ],
  "stop": [
    {
      "exec": "/usr/bin/ziroctl",
      "args": [
        "cf",
        "down"
      ]
    }
  ],
  "health": {
    "exec": "/var/lib/ziro/plugins/cloudflared/cloudflared",
    "args": [
      "--version"
    ],
    "expect": "cloudflared version"
  }
}
