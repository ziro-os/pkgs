{
  "name": "tailscale",
  "version": "1.104.6",
  "description": "Tailscale: reach this host over your tailnet (runs unprivileged, nothing open by default; ziroctl tailscale up)",
  "min_memory_mb": 512,
  "settings": [
    {
      "name": "port",
      "description": "UDP port tailscaled listens on (1024-65535)",
      "default": "41642",
      "pattern": "^[0-9]{4,5}$"
    },
    {
      "name": "telemetry",
      "description": "Let tailscaled upload logs to Tailscale (on or off)",
      "default": "off",
      "pattern": "^(on|off)$"
    },
    {
      "name": "auto_update",
      "description": "Upgrade daily to the newest pinned release (true or false)",
      "default": "true",
      "pattern": "^(true|false)$"
    }
  ],
  "artifacts": [
    {
      "url": "https://github.com/ziro-os/pkgs/releases/download/tailscale-1.104.6/tailscaled-linux-amd64",
      "sha256": "01106e93593dfe01ba6d8615ba5de40222ce3e54797525cc66ef7795f682c216",
      "path": "/var/lib/ziro/plugins/tailscale/tailscaled",
      "mode": "0755",
      "arch": "x86_64"
    },
    {
      "url": "https://github.com/ziro-os/pkgs/releases/download/tailscale-1.104.6/tailscale-linux-amd64",
      "sha256": "a781895a86932424dce380c8b445c77b8568dd2248a7fed20ba77ce3cb221185",
      "path": "/var/lib/ziro/plugins/tailscale/tailscale",
      "mode": "0755",
      "arch": "x86_64"
    },
    {
      "url": "https://github.com/ziro-os/pkgs/releases/download/tailscale-1.104.6/tailscaled-linux-arm64",
      "sha256": "904044a58d6b22426fa2ff2307f774dc69c0edda0c5053bc3de53fb11a0b8e40",
      "path": "/var/lib/ziro/plugins/tailscale/tailscaled",
      "mode": "0755",
      "arch": "aarch64"
    },
    {
      "url": "https://github.com/ziro-os/pkgs/releases/download/tailscale-1.104.6/tailscale-linux-arm64",
      "sha256": "2e547c5e8acb4e9dc7c3ae576c302346044bd2f30958515cca5b7a91fb5cd636",
      "path": "/var/lib/ziro/plugins/tailscale/tailscale",
      "mode": "0755",
      "arch": "aarch64"
    }
  ],
  "dirs": [
    {
      "path": "/var/lib/ziro/tailscale",
      "mode": "0700"
    },
    {
      "path": "/etc/ziro/tailscale",
      "mode": "0700"
    }
  ],
  "cron": [
    "37 4 * * * /usr/bin/ziroctl tailscale update --cron"
  ],
  "post_start": [
    {
      "exec": "/usr/bin/ziroctl",
      "args": [
        "tailscale",
        "setup"
      ],
      "timeout": "1m"
    }
  ],
  "health": {
    "exec": "/var/lib/ziro/plugins/tailscale/tailscaled",
    "args": [
      "--version"
    ],
    "timeout": "20s"
  },
  "stop": [
    {
      "exec": "/usr/bin/ziroctl",
      "args": [
        "tailscale",
        "teardown"
      ]
    }
  ]
}
