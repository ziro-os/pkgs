{
  "name": "tailscale",
  "version": "1.104.5",
  "description": "Tailscale: reach this host over your tailnet (runs unprivileged, nothing open by default; ziroctl tailscale up)",
  "min_memory_mb": 512,
  "settings": [
    {
      "name": "port",
      "description": "UDP port tailscaled listens on (1024-65535)",
      "default": "41642",
      "pattern": "^[0-9]{4,5}$"
    },
    {
      "name": "telemetry",
      "description": "Let tailscaled upload logs to Tailscale (on or off)",
      "default": "off",
      "pattern": "^(on|off)$"
    },
    {
      "name": "auto_update",
      "description": "Upgrade daily to the newest pinned release (true or false)",
      "default": "true",
      "pattern": "^(true|false)$"
    }
  ],
  "artifacts": [
    {
      "url": "https://github.com/ziro-os/pkgs/releases/download/tailscale-1.104.5/tailscaled-linux-amd64",
      "sha256": "0dd3bfb1c8316cb6b6bb23d41d716a976313e8aa9387abc722e2a14782c06bbf",
      "path": "/var/lib/ziro/plugins/tailscale/tailscaled",
      "mode": "0755",
      "arch": "x86_64"
    },
    {
      "url": "https://github.com/ziro-os/pkgs/releases/download/tailscale-1.104.5/tailscale-linux-amd64",
      "sha256": "ae6d013e3a9dac4d6ae7cd682cf89215e512d6f12ae94d39c72a93f13d2fce66",
      "path": "/var/lib/ziro/plugins/tailscale/tailscale",
      "mode": "0755",
      "arch": "x86_64"
    },
    {
      "url": "https://github.com/ziro-os/pkgs/releases/download/tailscale-1.104.5/tailscaled-linux-arm64",
      "sha256": "d1532cdbbe9c9a86275939b9130e837da8bb7223d2647996b7b1fabf48bc8359",
      "path": "/var/lib/ziro/plugins/tailscale/tailscaled",
      "mode": "0755",
      "arch": "aarch64"
    },
    {
      "url": "https://github.com/ziro-os/pkgs/releases/download/tailscale-1.104.5/tailscale-linux-arm64",
      "sha256": "a000d3ee4734531da8e0b2874453e01c6f841e6fea9edae8621f4b2e4e45ab48",
      "path": "/var/lib/ziro/plugins/tailscale/tailscale",
      "mode": "0755",
      "arch": "aarch64"
    }
  ],
  "dirs": [
    {
      "path": "/var/lib/ziro/tailscale",
      "mode": "0700"
    },
    {
      "path": "/etc/ziro/tailscale",
      "mode": "0700"
    }
  ],
  "cron": [
    "37 4 * * * /usr/bin/ziroctl tailscale update --cron"
  ],
  "post_start": [
    {
      "exec": "/usr/bin/ziroctl",
      "args": [
        "tailscale",
        "setup"
      ],
      "timeout": "1m"
    }
  ],
  "health": {
    "exec": "/var/lib/ziro/plugins/tailscale/tailscaled",
    "args": [
      "--version"
    ],
    "timeout": "20s"
  },
  "stop": [
    {
      "exec": "/usr/bin/ziroctl",
      "args": [
        "tailscale",
        "teardown"
      ]
    }
  ]
}
