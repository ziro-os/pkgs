{
  "name": "tailscale",
  "version": "1.104.2",
  "description": "Tailscale: reach this host over your tailnet (runs unprivileged, nothing open by default; ziroctl tailscale up)",
  "min_memory_mb": 512,
  "settings": [
    {
      "name": "port",
      "description": "UDP port tailscaled listens on (1024-65535)",
      "default": "41642",
      "pattern": "^[0-9]{4,5}$"
    },
    {
      "name": "telemetry",
      "description": "Let tailscaled upload logs to Tailscale (on or off)",
      "default": "off",
      "pattern": "^(on|off)$"
    },
    {
      "name": "auto_update",
      "description": "Upgrade daily to the newest pinned release (true or false)",
      "default": "true",
      "pattern": "^(true|false)$"
    }
  ],
  "artifacts": [
    {
      "url": "https://github.com/ziro-os/pkgs/releases/download/tailscale-1.104.2/tailscaled-linux-amd64",
      "sha256": "2b391d03f7cf25c4e0d11d344d577deca94436efad1ae9af002e46269d951ba3",
      "path": "/var/lib/ziro/plugins/tailscale/tailscaled",
      "mode": "0755",
      "arch": "x86_64"
    },
    {
      "url": "https://github.com/ziro-os/pkgs/releases/download/tailscale-1.104.2/tailscale-linux-amd64",
      "sha256": "790cf117e5ddb64421faed041490274e65c47ad6c90e9d4ce2cb3968ad06e535",
      "path": "/var/lib/ziro/plugins/tailscale/tailscale",
      "mode": "0755",
      "arch": "x86_64"
    },
    {
      "url": "https://github.com/ziro-os/pkgs/releases/download/tailscale-1.104.2/tailscaled-linux-arm64",
      "sha256": "3978859251e2f996d0c8dd44a5966c51876c15221eb6970fd6b4239f2457544b",
      "path": "/var/lib/ziro/plugins/tailscale/tailscaled",
      "mode": "0755",
      "arch": "aarch64"
    },
    {
      "url": "https://github.com/ziro-os/pkgs/releases/download/tailscale-1.104.2/tailscale-linux-arm64",
      "sha256": "f56aaf3f64e2e9843b55dd4760bb097c62df01b255dae79b4d2680b387dae464",
      "path": "/var/lib/ziro/plugins/tailscale/tailscale",
      "mode": "0755",
      "arch": "aarch64"
    }
  ],
  "dirs": [
    {
      "path": "/var/lib/ziro/tailscale",
      "mode": "0700"
    },
    {
      "path": "/etc/ziro/tailscale",
      "mode": "0700"
    }
  ],
  "cron": [
    "37 4 * * * /usr/bin/ziroctl tailscale update --cron"
  ],
  "post_start": [
    {
      "exec": "/usr/bin/ziroctl",
      "args": [
        "tailscale",
        "setup"
      ],
      "timeout": "1m"
    }
  ],
  "health": {
    "exec": "/var/lib/ziro/plugins/tailscale/tailscaled",
    "args": [
      "--version"
    ],
    "timeout": "20s"
  },
  "stop": [
    {
      "exec": "/usr/bin/ziroctl",
      "args": [
        "tailscale",
        "teardown"
      ]
    }
  ]
}
