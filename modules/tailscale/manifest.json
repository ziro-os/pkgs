{
  "name": "tailscale",
  "version": "1.104.7",
  "description": "Tailscale: reach this host over your tailnet (runs unprivileged, nothing open by default; ziroctl tailscale up)",
  "min_memory_mb": 512,
  "settings": [
    {
      "name": "port",
      "description": "UDP port tailscaled listens on (1024-65535)",
      "default": "41642",
      "pattern": "^[0-9]{4,5}$"
    },
    {
      "name": "telemetry",
      "description": "Let tailscaled upload logs to Tailscale (on or off)",
      "default": "off",
      "pattern": "^(on|off)$"
    },
    {
      "name": "auto_update",
      "description": "Upgrade daily to the newest pinned release (true or false)",
      "default": "true",
      "pattern": "^(true|false)$"
    }
  ],
  "artifacts": [
    {
      "url": "https://github.com/ziro-os/pkgs/releases/download/tailscale-1.104.7/tailscaled-linux-amd64",
      "sha256": "38f0ffb0f156ca3ebad33c420bea626933e877be54c38c66cfa155dfa84540af",
      "path": "/var/lib/ziro/plugins/tailscale/tailscaled",
      "mode": "0755",
      "arch": "x86_64"
    },
    {
      "url": "https://github.com/ziro-os/pkgs/releases/download/tailscale-1.104.7/tailscale-linux-amd64",
      "sha256": "6ff883f468ded6221ba16a34c09cbf8ba4488bf889bf6575e040684677e1a02c",
      "path": "/var/lib/ziro/plugins/tailscale/tailscale",
      "mode": "0755",
      "arch": "x86_64"
    },
    {
      "url": "https://github.com/ziro-os/pkgs/releases/download/tailscale-1.104.7/tailscaled-linux-arm64",
      "sha256": "bd34e19b71fdbb11a6e603ac69af5e4d360ea983d0d9f93ff0a7210afff52ad5",
      "path": "/var/lib/ziro/plugins/tailscale/tailscaled",
      "mode": "0755",
      "arch": "aarch64"
    },
    {
      "url": "https://github.com/ziro-os/pkgs/releases/download/tailscale-1.104.7/tailscale-linux-arm64",
      "sha256": "362426a7417d85879cb76ae767375b1e839996cc63d5d2ebccd5b8bfdc736ec8",
      "path": "/var/lib/ziro/plugins/tailscale/tailscale",
      "mode": "0755",
      "arch": "aarch64"
    }
  ],
  "dirs": [
    {
      "path": "/var/lib/ziro/tailscale",
      "mode": "0700"
    },
    {
      "path": "/etc/ziro/tailscale",
      "mode": "0700"
    }
  ],
  "cron": [
    "37 4 * * * /usr/bin/ziroctl tailscale update --cron"
  ],
  "post_start": [
    {
      "exec": "/usr/bin/ziroctl",
      "args": [
        "tailscale",
        "setup"
      ],
      "timeout": "1m"
    }
  ],
  "health": {
    "exec": "/var/lib/ziro/plugins/tailscale/tailscaled",
    "args": [
      "--version"
    ],
    "timeout": "20s"
  },
  "stop": [
    {
      "exec": "/usr/bin/ziroctl",
      "args": [
        "tailscale",
        "teardown"
      ]
    }
  ]
}
